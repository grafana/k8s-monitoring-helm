// Feature: CloudWatch Metrics
declare "cloudwatch_metrics" {
  argument "metrics_destinations" {
    comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
  }

  prometheus.exporter.cloudwatch "production" {
    sts_region = "eu-central-1"
    fips_disabled = true
    discovery {
      type = "AWS/SQS"
      regions = ["eu-central-1"]
      search_tags = {
        "scrape" = "true",
      }
      metric {
        name = "NumberOfMessagesSent"
        statistics = ["Sum"]
      }
      metric {
        name = "ApproximateAgeOfOldestMessage"
        statistics = ["Maximum"]
      }
    }
    discovery {
      type = "AWS/ELB"
      regions = ["eu-central-1"]
      metric {
        name = "RequestCount"
        statistics = ["Sum"]
        period = "1m"
      }
    }
  } // prometheus.exporter.cloudwatch "production"

  prometheus.scrape "production" {
    targets = prometheus.exporter.cloudwatch.production.targets
    clustering {
      enabled = true
    }

    scrape_interval = "60s"
    scrape_timeout = "10s"
    scrape_protocols = ["OpenMetricsText1.0.0","OpenMetricsText0.0.1","PrometheusText0.0.4"]
    scrape_classic_histograms = false
    scrape_native_histograms = false
    forward_to = [prometheus.relabel.production.receiver]
  } // prometheus.scrape "production"

  prometheus.relabel "production" {
    max_cache_size = 100000
    rule {
      target_label = "instance"
      replacement = "production"
    }
    rule {
      target_label = "job"
      replacement = "integrations/cloudwatch"
    }
    forward_to = argument.metrics_destinations.value
  } // prometheus.relabel "production"
} // declare "cloudwatch_metrics"
cloudwatch_metrics "feature" {
  metrics_destinations = [
    prometheus.remote_write.prometheus.receiver,
  ]
}
// Self Reporting
prometheus.exporter.unix "kubernetes_monitoring_telemetry" {
  set_collectors = ["textfile"]
  textfile {
    directory = "/etc/release-info"
  }
} // prometheus.exporter.unix "kubernetes_monitoring_telemetry"

discovery.relabel "kubernetes_monitoring_telemetry" {
  targets = prometheus.exporter.unix.kubernetes_monitoring_telemetry.targets
  rule {
    target_label = "instance"
    action = "replace"
    replacement = "k8smon"
  }
  rule {
    target_label = "job"
    action = "replace"
    replacement = "integrations/kubernetes/kubernetes_monitoring_telemetry"
  }
} // discovery.relabel "kubernetes_monitoring_telemetry"

prometheus.scrape "kubernetes_monitoring_telemetry" {
  job_name   = "integrations/kubernetes/kubernetes_monitoring_telemetry"
  targets    = discovery.relabel.kubernetes_monitoring_telemetry.output
  scrape_interval = "60s"
  clustering {
    enabled = true
  }
  forward_to = [prometheus.relabel.kubernetes_monitoring_telemetry.receiver]
} // prometheus.scrape "kubernetes_monitoring_telemetry"

prometheus.relabel "kubernetes_monitoring_telemetry" {
  rule {
    source_labels = ["__name__"]
    regex = "grafana_kubernetes_monitoring_.*"
    action = "keep"
  }
  forward_to = [
    prometheus.remote_write.prometheus.receiver,
  ]
} // prometheus.relabel "kubernetes_monitoring_telemetry"





// Destination: prometheus (prometheus)
otelcol.exporter.prometheus "prometheus" {
  add_metric_suffixes = true
  resource_to_telemetry_conversion = false
  keep_identifying_resource_attributes = true
  forward_to = [prometheus.remote_write.prometheus.receiver]
} // otelcol.exporter.prometheus "prometheus"

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus.prometheus.svc:9090/api/v1/write"
    headers = {
    }
    tls_config {
      insecure_skip_verify = false
    }
    send_native_histograms = false

    queue_config {
      capacity = 10000
      min_shards = 1
      max_shards = 50
      max_samples_per_send = 2000
      batch_send_deadline = "5s"
      min_backoff = "30ms"
      max_backoff = "5s"
      retry_on_http_429 = true
      sample_age_limit = "0s"
    }
  }

  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
  external_labels = {
    "cluster" = "cloudwatch-metrics-cluster",
    "k8s_cluster_name" = "cloudwatch-metrics-cluster",
  }
} // prometheus.remote_write "prometheus"

