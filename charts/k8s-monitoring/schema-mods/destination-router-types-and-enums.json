{
  "definitions": {
    "router-destination": {"properties": {
      "attribute": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_./-]*$"
      },
      "defaultDestinations": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      },
      "routes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "destinations": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            },
            "signals": {
              "type": "array",
              "items": {"enum": ["metrics", "logs", "traces", "profiles"]}
            },
            "match": {
              "type": "object",
              "properties": {
                "in": {"type": "array"}
              },
              "oneOf": [
                {"required": ["equals"]},
                {"required": ["in"]},
                {"required": ["matches"]}
              ]
            }
          }
        }
      }
    }}
  }
}
