{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "collector": {
            "type": "string"
        },
        "databaseObservability": {
            "type": "object",
            "properties": {
                "cloudProvider": {
                    "type": "object",
                    "properties": {
                        "aws": {
                            "type": "object",
                            "properties": {
                                "arn": {
                                    "type": "string"
                                }
                            }
                        },
                        "azure": {
                            "type": "object",
                            "properties": {
                                "resourceGroup": {
                                    "type": "string"
                                },
                                "serverName": {
                                    "type": "string"
                                },
                                "subscriptionId": {
                                    "type": "string"
                                }
                            }
                        },
                        "gcp": {
                            "type": "object",
                            "properties": {
                                "connectionName": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "collectors": {
                    "type": "object",
                    "properties": {
                        "explainPlans": {
                            "type": "object",
                            "properties": {
                                "collectInterval": {
                                    "type": "string"
                                },
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "queryDetails": {
                            "type": "object",
                            "properties": {
                                "collectInterval": {
                                    "type": "string"
                                },
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "queryMetrics": {
                            "type": "object",
                            "properties": {
                                "collectInterval": {
                                    "type": "string"
                                },
                                "enabled": {
                                    "type": "boolean"
                                },
                                "statementsLimit": {
                                    "type": "null"
                                },
                                "statementsLookback": {
                                    "type": "string"
                                }
                            }
                        },
                        "querySamples": {
                            "type": "object",
                            "properties": {
                                "collectInterval": {
                                    "type": "string"
                                },
                                "disableQueryRedaction": {
                                    "type": "boolean"
                                },
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "schemaDetails": {
                            "type": "object",
                            "properties": {
                                "collectInterval": {
                                    "type": "string"
                                },
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "excludeCurrentUser": {
                    "type": "boolean"
                },
                "excludeDatabases": {
                    "type": "array"
                },
                "excludeSchemas": {
                    "type": "array"
                },
                "excludeUsers": {
                    "type": "array"
                },
                "labels": {
                    "type": "object"
                },
                "queryTimeout": {
                    "type": "string"
                }
            }
        },
        "exporter": {
            "type": "object",
            "properties": {
                "connectionName": {
                    "type": "string"
                },
                "dataSource": {
                    "type": "object",
                    "properties": {
                        "auth": {
                            "type": "object",
                            "properties": {
                                "password": {
                                    "type": "string"
                                },
                                "passwordFrom": {
                                    "type": "string"
                                },
                                "passwordKey": {
                                    "type": "string"
                                },
                                "username": {
                                    "type": "string"
                                },
                                "usernameFrom": {
                                    "type": "string"
                                },
                                "usernameKey": {
                                    "type": "string"
                                }
                            }
                        },
                        "database": {
                            "type": "string"
                        },
                        "host": {
                            "type": "string"
                        },
                        "params": {
                            "type": "object",
                            "properties": {
                                "appName": {
                                    "type": "string"
                                },
                                "authenticator": {
                                    "type": "string"
                                },
                                "encrypt": {
                                    "type": "string"
                                },
                                "extra": {
                                    "type": "object"
                                },
                                "hostNameInCertificate": {
                                    "type": "string"
                                },
                                "trustServerCertificate": {
                                    "type": "string"
                                }
                            }
                        },
                        "port": {
                            "type": "integer"
                        }
                    }
                },
                "dataSourceName": {
                    "type": "string"
                },
                "dataSourceNameFrom": {
                    "type": "string"
                },
                "maxConnectionLifetime": {
                    "type": "string"
                },
                "maxIdleConnections": {
                    "type": "null"
                },
                "maxOpenConnections": {
                    "type": "null"
                },
                "queryConfig": {
                    "type": "string"
                },
                "queryConfigFrom": {
                    "type": "string"
                },
                "timeout": {
                    "type": "string"
                }
            }
        },
        "jobLabel": {
            "type": "string"
        },
        "logs": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "labelSelectors": {
                    "type": "object"
                },
                "namespaces": {
                    "type": "array"
                }
            }
        },
        "metrics": {
            "type": "object",
            "properties": {
                "cacheTTL": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "extraMetricProcessingRules": {
                    "type": "string"
                },
                "maxCacheSize": {
                    "type": "null"
                },
                "scrapeInterval": {
                    "type": "string"
                },
                "scrapeTimeout": {
                    "type": "string"
                },
                "tuning": {
                    "type": "object",
                    "properties": {
                        "excludeMetrics": {
                            "type": "array"
                        },
                        "includeMetrics": {
                            "type": "array"
                        }
                    }
                }
            }
        },
        "name": {
            "type": "string"
        },
        "secret": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "null"
                },
                "embed": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string"
                }
            }
        }
    }
}
