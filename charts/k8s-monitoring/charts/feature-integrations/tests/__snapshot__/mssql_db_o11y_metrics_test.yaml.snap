adds custom labels to db o11y metrics and logs:
  1: |
    |-
      declare "mssql_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }
        argument "logs_destinations" {
          comment = "Must be a list of log destinations where collected logs should be forwarded to"
        }

        prometheus.exporter.mssql "my_database" {
          connection_string = string.format("sqlserver://%s:%d",
            "my-db.mssql.svc",
            1433,
          )
        }

        database_observability.sql_server "my_database" {
          targets = prometheus.exporter.mssql.my_database.targets
          data_source_name = string.format("sqlserver://%s:%d",
            "my-db.mssql.svc",
            1433,
          )
          exclude_current_user = true
          explain_plans {
            collect_interval = "1m"
          }
          query_details {
            collect_interval = "1m"
          }
          query_metrics {
            collect_interval = "1m"
            statements_lookback = "1h"
          }
          query_samples {
            collect_interval = "10s"
            disable_query_redaction = false
          }
          schema_details {
            collect_interval = "1m"
          }
          enable_collectors = ["explain_plans","query_details","query_metrics","query_samples","schema_details"]

          forward_to = [loki.relabel.database_observability_sqlserver_my_database.receiver]
        }

        loki.relabel "database_observability_sqlserver_my_database" {
          forward_to = argument.logs_destinations.value
          rule {
            target_label = "job"
            replacement = "integrations/db-o11y"
          }
          rule {
            source_labels = ["instance"]
            target_label = "dsn"
          }
          rule {
            target_label = "instance"
            replacement = "my-database"
          }
          rule {
            target_label = "environment"
            replacement = "production"
          }
          rule {
            target_label = "team"
            replacement = "payments"
          }
        }

        discovery.relabel "database_observability_sqlserver_my_database" {
          targets = database_observability.sql_server.my_database.targets
          rule {
            target_label = "job"
            replacement = "integrations/db-o11y"
          }
          rule {
            source_labels = ["instance"]
            target_label = "dsn"
          }
          rule {
            target_label = "instance"
            replacement = "my-database"
          }
          rule {
            target_label = "environment"
            replacement = "production"
          }
          rule {
            target_label = "team"
            replacement = "payments"
          }
        }
        prometheus.scrape "my_database" {
          targets = discovery.relabel.database_observability_sqlserver_my_database.output
          clustering {
            enabled = true
          }

          scrape_interval = "60s"
          scrape_timeout = "10s"
          scrape_protocols = ["OpenMetricsText1.0.0","OpenMetricsText0.0.1","PrometheusText0.0.4"]
          scrape_classic_histograms = false
          scrape_native_histograms = false
          forward_to = argument.metrics_destinations.value
        }
      }
keeps prometheus.relabel when metrics tuning is set under db o11y:
  1: |
    |-
      declare "mssql_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }
        argument "logs_destinations" {
          comment = "Must be a list of log destinations where collected logs should be forwarded to"
        }

        remote.kubernetes.secret "my_database" {
          name      = "my-database-release-name-feature-integrations"
          namespace = "NAMESPACE"
        } // remote.kubernetes.secret "my_database"

        prometheus.exporter.mssql "my_database" {
          connection_string = string.format("sqlserver://%s:%s@%s:%d",
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.my_database.data["username"])),
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.my_database.data["password"])),
            "my-db.mssql.svc",
            1433,
          )
        }

        database_observability.sql_server "my_database" {
          targets = prometheus.exporter.mssql.my_database.targets
          data_source_name = string.format("sqlserver://%s:%s@%s:%d",
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.my_database.data["username"])),
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.my_database.data["password"])),
            "my-db.mssql.svc",
            1433,
          )
          exclude_current_user = true
          explain_plans {
            collect_interval = "1m"
          }
          query_details {
            collect_interval = "1m"
          }
          query_metrics {
            collect_interval = "1m"
            statements_lookback = "1h"
          }
          query_samples {
            collect_interval = "10s"
            disable_query_redaction = false
          }
          schema_details {
            collect_interval = "1m"
          }
          enable_collectors = ["explain_plans","query_details","query_metrics","query_samples","schema_details"]

          forward_to = [loki.relabel.database_observability_sqlserver_my_database.receiver]
        }

        loki.relabel "database_observability_sqlserver_my_database" {
          forward_to = argument.logs_destinations.value
          rule {
            target_label = "job"
            replacement = "integrations/db-o11y"
          }
          rule {
            source_labels = ["instance"]
            target_label = "dsn"
          }
          rule {
            target_label = "instance"
            replacement = "my-database"
          }
        }

        discovery.relabel "database_observability_sqlserver_my_database" {
          targets = database_observability.sql_server.my_database.targets
          rule {
            target_label = "job"
            replacement = "integrations/db-o11y"
          }
          rule {
            source_labels = ["instance"]
            target_label = "dsn"
          }
          rule {
            target_label = "instance"
            replacement = "my-database"
          }
        }
        prometheus.scrape "my_database" {
          targets = discovery.relabel.database_observability_sqlserver_my_database.output
          clustering {
            enabled = true
          }

          scrape_interval = "60s"
          scrape_timeout = "10s"
          scrape_protocols = ["OpenMetricsText1.0.0","OpenMetricsText0.0.1","PrometheusText0.0.4"]
          scrape_classic_histograms = false
          scrape_native_histograms = false
          forward_to = [prometheus.relabel.my_database.receiver]
        }

        prometheus.relabel "my_database" {
          max_cache_size = 100000
          rule {
            source_labels = ["__name__"]
            regex = "mssql_deadlocks_.*"
            action = "drop"
          }
          forward_to = argument.metrics_destinations.value
        }
      }
renders sql_server db o11y options:
  1: |
    |-
      declare "mssql_integration" {
        argument "metrics_destinations" {
          comment = "Must be a list of metric destinations where collected metrics should be forwarded to"
        }
        argument "logs_destinations" {
          comment = "Must be a list of log destinations where collected logs should be forwarded to"
        }

        remote.kubernetes.secret "azure_db" {
          name      = "azure-db-release-name-feature-integrations"
          namespace = "NAMESPACE"
        } // remote.kubernetes.secret "azure_db"

        prometheus.exporter.mssql "azure_db" {
          connection_string = string.format("sqlserver://%s:%s@%s:%d",
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.azure_db.data["username"])),
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.azure_db.data["password"])),
            "azure-db.mssql.svc",
            1433,
          )
        }

        database_observability.sql_server "azure_db" {
          targets = prometheus.exporter.mssql.azure_db.targets
          data_source_name = string.format("sqlserver://%s:%s@%s:%d",
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.azure_db.data["username"])),
            encoding.url_encode(convert.nonsensitive(remote.kubernetes.secret.azure_db.data["password"])),
            "azure-db.mssql.svc",
            1433,
          )
          exclude_current_user = false
          exclude_schemas = ["reporting"]
          exclude_databases = ["temp_reporting"]
          exclude_users = ["readonly"]
          query_timeout = "20s"
          cloud_provider {
            azure {
              subscription_id = "sub-123"
              resource_group = "rg-prod"
              server_name = "my-azure-server"
            }
          }
          explain_plans {
            collect_interval = "1m"
          }
          query_details {
            collect_interval = "2m"
          }
          query_metrics {
            collect_interval = "30s"
            statements_limit = 100
            statements_lookback = "2h"
          }
          query_samples {
            collect_interval = "15s"
            disable_query_redaction = true
          }
          enable_collectors = ["explain_plans","query_details","query_metrics","query_samples"]
          disable_collectors = ["schema_details"]

          forward_to = [loki.relabel.database_observability_sqlserver_azure_db.receiver]
        }

        loki.relabel "database_observability_sqlserver_azure_db" {
          forward_to = argument.logs_destinations.value
          rule {
            target_label = "job"
            replacement = "integrations/db-o11y"
          }
          rule {
            source_labels = ["instance"]
            target_label = "dsn"
          }
          rule {
            target_label = "instance"
            replacement = "azure-db"
          }
        }

        discovery.relabel "database_observability_sqlserver_azure_db" {
          targets = database_observability.sql_server.azure_db.targets
          rule {
            target_label = "job"
            replacement = "integrations/db-o11y"
          }
          rule {
            source_labels = ["instance"]
            target_label = "dsn"
          }
          rule {
            target_label = "instance"
            replacement = "azure-db"
          }
        }
        prometheus.scrape "azure_db" {
          targets = discovery.relabel.database_observability_sqlserver_azure_db.output
          clustering {
            enabled = true
          }

          scrape_interval = "60s"
          scrape_timeout = "10s"
          scrape_protocols = ["OpenMetricsText1.0.0","OpenMetricsText0.0.1","PrometheusText0.0.4"]
          scrape_classic_histograms = false
          scrape_native_histograms = false
          forward_to = argument.metrics_destinations.value
        }
      }
