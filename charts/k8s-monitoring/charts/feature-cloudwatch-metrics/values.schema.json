{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "maxCacheSize": {
                    "type": "integer"
                },
                "namespaceOverride": {
                    "type": "string"
                },
                "scrapeClassicHistograms": {
                    "type": "boolean"
                },
                "scrapeInterval": {
                    "type": "string"
                },
                "scrapeNativeHistograms": {
                    "type": "boolean"
                },
                "scrapeProtocols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "scrapeTimeout": {
                    "type": "string"
                }
            }
        },
        "instances": {
            "type": "array"
        }
    }
}
