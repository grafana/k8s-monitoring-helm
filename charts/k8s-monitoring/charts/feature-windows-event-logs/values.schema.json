{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "bookmarks": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "hostPath": {
                    "type": "string"
                }
            }
        },
        "excludeEventData": {
            "type": "boolean"
        },
        "excludeEventMessage": {
            "type": "boolean"
        },
        "excludeUserData": {
            "type": "boolean"
        },
        "extraLabels": {
            "type": "object"
        },
        "extraLogProcessingStages": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "properties": {
                "namespaceOverride": {
                    "type": "string"
                }
            }
        },
        "locale": {
            "type": "integer"
        },
        "pollInterval": {
            "type": "string"
        },
        "sources": {
            "type": "array"
        },
        "structuredMetadata": {
            "type": "object"
        },
        "useIncomingTimestamp": {
            "type": "boolean"
        }
    }
}
