// Self Reporting
prometheus.exporter.unix "kubernetes_monitoring_telemetry" {
  set_collectors = ["textfile"]
  textfile {
    directory = "/etc/release-info"
  }
} // prometheus.exporter.unix "kubernetes_monitoring_telemetry"

discovery.relabel "kubernetes_monitoring_telemetry" {
  targets = prometheus.exporter.unix.kubernetes_monitoring_telemetry.targets
  rule {
    target_label = "instance"
    action = "replace"
    replacement = "k8smon"
  }
  rule {
    target_label = "job"
    action = "replace"
    replacement = "integrations/kubernetes/kubernetes_monitoring_telemetry"
  }
} // discovery.relabel "kubernetes_monitoring_telemetry"

prometheus.scrape "kubernetes_monitoring_telemetry" {
  job_name   = "integrations/kubernetes/kubernetes_monitoring_telemetry"
  targets    = discovery.relabel.kubernetes_monitoring_telemetry.output
  scrape_interval = "60s"
  clustering {
    enabled = true
  }
  forward_to = [prometheus.relabel.kubernetes_monitoring_telemetry.receiver]
} // prometheus.scrape "kubernetes_monitoring_telemetry"

prometheus.relabel "kubernetes_monitoring_telemetry" {
  rule {
    source_labels = ["__name__"]
    regex = "grafana_kubernetes_monitoring_.*"
    action = "keep"
  }
  forward_to = [
    prometheus.remote_write.prometheus.receiver,
  ]
} // prometheus.relabel "kubernetes_monitoring_telemetry"



discovery.kubernetes "self" {
  role = "pod"
  selectors {
    role  = "pod"
    label = "app.kubernetes.io/instance=k8smon-alloy-custom"
  }
}

discovery.relabel "self" {
  targets = discovery.kubernetes.self.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "http-metrics"
    action        = "keep"
  }
}

remote.kubernetes.secret "prometheus_credentials" {
  name      = "prometheus-credentials"
  namespace = "credentials"
}

remote.kubernetes.configmap "settings" {
  name      = "rbac-settings"
  namespace = "credentials"
}

prometheus.scrape "self" {
  targets    = discovery.relabel.self.output
  job_name   = "extra-config"
  forward_to = [prometheus.remote_write.extra_config.receiver]
}

discovery.kubelet "self" {
  url               = "https://" + sys.env("HOSTNAME") + ":10250"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    insecure_skip_verify = true
  }
}

discovery.kubernetes "self_metadata" {
  role = "pod"
  selectors {
    role  = "pod"
    label = "app.kubernetes.io/instance=k8smon-alloy-custom"
  }
  attach_metadata {
    node      = true
    namespace = true
  }
}

discovery.kubernetes "self_endpointslice" {
  role = "endpointslice"
  namespaces {
    names = ["default"]
  }
  selectors {
    role  = "endpointslice"
    label = "kubernetes.io/service-name=k8smon-alloy-custom"
  }
}

discovery.kubernetes "ingresses" {
  role = "ingress"
  namespaces {
    names = ["credentials"]
  }
}

discovery.relabel "kubelet_self" {
  targets = discovery.kubelet.self.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_instance", "__meta_kubernetes_pod_container_port_name"]
    regex         = "k8smon-alloy-custom;http-metrics"
    action        = "keep"
  }
  rule {
    target_label = "source"
    replacement  = "kubelet"
  }
}

discovery.relabel "metadata_self" {
  targets = discovery.kubernetes.self_metadata.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "http-metrics"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_label_kubernetes_io_os"]
    target_label  = "node_os"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace_label_kubernetes_io_metadata_name"]
    target_label  = "namespace_name"
  }
  rule {
    target_label = "source"
    replacement  = "attach-metadata"
  }
}

discovery.relabel "endpointslice_self" {
  targets = discovery.kubernetes.self_endpointslice.targets
  rule {
    source_labels = ["__meta_kubernetes_endpointslice_port_name"]
    regex         = "http-metrics"
    action        = "keep"
  }
  rule {
    target_label = "source"
    replacement  = "endpointslice"
  }
}

// An Ingress target is its host, so scrape this collector instead to show that the Ingress was discovered.
discovery.relabel "ingress_self" {
  targets = discovery.kubernetes.ingresses.targets
  rule {
    target_label = "__address__"
    replacement  = "k8smon-alloy-custom.default.svc:12345"
  }
  rule {
    target_label = "source"
    replacement  = "ingress"
  }
}

prometheus.scrape "discovery_variants" {
  targets = array.concat(
    discovery.relabel.kubelet_self.output,
    discovery.relabel.metadata_self.output,
    discovery.relabel.endpointslice_self.output,
    discovery.relabel.ingress_self.output,
  )
  job_name   = "discovery-variants"
  forward_to = [prometheus.remote_write.extra_config.receiver]
}

prometheus.remote_write "extra_config" {
  endpoint {
    url = "http://prometheus-server.prometheus.svc:9090/api/v1/write"
    basic_auth {
      username = convert.nonsensitive(remote.kubernetes.secret.prometheus_credentials.data["username"])
      password = remote.kubernetes.secret.prometheus_credentials.data["password"]
    }
  }
  external_labels = {
    cluster       = "rbac-minimal-extra-config",
    config_source = remote.kubernetes.configmap.settings.data["source"],
  }
}

// Destination: prometheus (prometheus)
otelcol.exporter.prometheus "prometheus" {
  add_metric_suffixes = true
  resource_to_telemetry_conversion = false
  keep_identifying_resource_attributes = true
  forward_to = [prometheus.remote_write.prometheus.receiver]
} // otelcol.exporter.prometheus "prometheus"

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus-server.prometheus.svc:9090/api/v1/write"
    headers = {
    }
    basic_auth {
      username = convert.nonsensitive(remote.kubernetes.secret.prometheus.data["username"])
      password = remote.kubernetes.secret.prometheus.data["password"]
    }
    tls_config {
      insecure_skip_verify = false
    }
    send_native_histograms = false

    queue_config {
      capacity = 10000
      min_shards = 1
      max_shards = 50
      max_samples_per_send = 2000
      batch_send_deadline = "5s"
      min_backoff = "30ms"
      max_backoff = "5s"
      retry_on_http_429 = true
      sample_age_limit = "0s"
    }
  }

  wal {
    truncate_frequency = "2h"
    min_keepalive_time = "5m"
    max_keepalive_time = "8h"
  }
  external_labels = {
    "cluster" = "rbac-minimal-extra-config",
    "k8s_cluster_name" = "rbac-minimal-extra-config",
  }
} // prometheus.remote_write "prometheus"

remote.kubernetes.secret "prometheus" {
  name      = "prometheus-k8smon-k8s-monitoring"
  namespace = "default"
} // remote.kubernetes.secret "prometheus"

