{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>grafana/grafana-renovate-config//presets/base"],
  "customManagers": [
    {
      "description": "Update docker image versions pinned in the Makefile",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z0-9_]+ = (?<currentValue>\\S+)"
      ]
    },
    {
      "description": "Update dependency versions pinned in ARG instructions in Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG [A-Z0-9_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Regenerate files after Helm dependency updates",
      "matchManagers": ["helmv3"],
      "postUpgradeTasks": {
        "commands": ["make clean build test"],
        "fileFilters": ["**/*"]
      }
    }
  ]
}
